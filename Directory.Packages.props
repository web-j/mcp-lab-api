<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <PackageVersion Include="Aspire.Npgsql" Version="17.0.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.McpInspector" Version="17.0.0" />
  </ItemGroup>
  <ItemGroup Label="ServiceDefaults">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
  </ItemGroup>
  <ItemGroup Label="Persistência">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Label="Auth">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Label="MCP">
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup Label="Testes">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
